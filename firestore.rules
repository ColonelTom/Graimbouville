rules_version = '2';

// =====================================================================
//  Règles de sécurité Firestore — Graimbouville
//  Seules les adresses email listées ci-dessous peuvent lire ou écrire.
//  Ce sont les identifiants des 5 profils (voir js/firebase-config.js).
//  Collez ce fichier dans Firebase > Firestore > Règles > Publier.
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function estMembreDeLaFamille() {
      return request.auth != null
        && request.auth.token.email in [
          'etienne.graimbouville@example.com',
          'caroline.graimbouville@example.com',
          'fabienne.graimbouville@example.com',
          'amelie.graimbouville@example.com',
          'matthias.graimbouville@example.com'
        ];
    }

    match /depenses/{id}   { allow read, write: if estMembreDeLaFamille(); }
    match /contacts/{id}   { allow read, write: if estMembreDeLaFamille(); }
    match /coffre/{id}     { allow read, write: if estMembreDeLaFamille(); }
    match /procedures/{id} { allow read, write: if estMembreDeLaFamille(); }
    match /photos/{id}     { allow read, write: if estMembreDeLaFamille(); }

    // Tout le reste est interdit
    match /{autre=**} { allow read, write: if false; }
  }
}
